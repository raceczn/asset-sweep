{
  "name": "asset-sweep",
  "version": "0.1.2",
  "description": "Zero-config CLI to find and sweep unused assets across React, Expo, Laravel, Python, and any codebase.",
  "type": "module",
  "bin": {
    "asset-sweep": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "assets",
    "unused-assets",
    "dead-code",
    "cli",
    "react",
    "expo",
    "nextjs",
    "laravel",
    "python"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean --shims",
    "prepublishOnly": "npx tsc --noEmit && npm run build && npm test",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "cac": "^6.7.14",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
